# =============================================================================
# Google Maps Platform API Key
# =============================================================================
#
# 1. Copy this file:
#      cp .env.example .env
#
# 2. Paste your API key below (ONE key powers everything):
#      - Places Autocomplete (address & ZIP search)
#      - Geocoding
#      - Distance Matrix (map distance indicator)
#      - Maps SDK (live map widget)
#
# 3. Enable these APIs in Google Cloud Console:
#      - Maps SDK for iOS
#      - Maps JavaScript API (web)
#      - Places API
#      - Geocoding API
#      - Distance Matrix API
#
# 4. Also paste the SAME key in these native/web config files:
#      - ios/Runner/Info.plist  →  GMSApiKey
#      - web/index.html       →  maps.googleapis.com script tag
#
# Never commit the real `.env` file to git.

GOOGLE_MAPS_API_KEY=

# Legacy alias (still supported):
# GOOGLE_PLACES_API_KEY=

# =============================================================================
# Admin Contact Us / Sponsorship notifications
# =============================================================================
#
# ADMIN_NOTIFY_EMAIL  → destination mailbox for inquiry alerts
# ADMIN_EMAIL_ENDPOINT → Formspree (or similar) webhook, e.g.
#   https://formspree.io/f/your_form_id
#   Leave empty for demo mode (in-app inbox + console log only).
# ADMIN_PIN → PIN to unlock Admin Inquiries / Messages (default: medgift)

ADMIN_NOTIFY_EMAIL=partnerships@medgift.us
ADMIN_EMAIL_ENDPOINT=
ADMIN_PIN=medgift

# Run locally (desktop/web):
#   flutter run
#
# Run on iOS/Android:
#   flutter run --dart-define-from-file=.env
#
# Or pass the key directly:
#   flutter run --dart-define=GOOGLE_MAPS_API_KEY=your_key_here
