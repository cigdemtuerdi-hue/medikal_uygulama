# MedGift US API — copy to .env and fill in values.
#   cp .env.example .env

PORT=3001
MONGODB_URI=memory
USE_MEMORY_DB=true
APP_ORIGIN=https://medgift.us

SEED_DEMO_USER_EMAIL=donor@medgift.us
SEED_DEMO_USER_PHONE=+15551234567

# false = send real email/SMS (requires credentials below)
# true  = log only (local UI testing without providers)
EMAIL_DRY_RUN=false
SMS_DRY_RUN=false

# --- Email (Nodemailer / SMTP) from info@medgift.us ---
FROM_EMAIL=info@medgift.us
# GoDaddy: smtpout.secureserver.net | Gmail: smtp.gmail.com | M365: smtp.office365.com
EMAIL_HOST=smtpout.secureserver.net
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=info@medgift.us
EMAIL_PASS=

# --- SMS (Twilio) ---
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
# Preferred: API Key SID (SK…) + Secret
TWILIO_API_KEY=
TWILIO_API_SECRET=
# Or Auth Token (Account Dashboard) instead of API Key pair:
# TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
