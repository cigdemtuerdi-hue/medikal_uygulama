# MedGift US API — copy to .env and fill in values.
#   cp .env.example .env

PORT=3001
MONGODB_URI=memory
USE_MEMORY_DB=true
APP_ORIGIN=https://medgift.us

SEED_DEMO_USER_EMAIL=donor@medgift.us
SEED_DEMO_USER_PHONE=+15551234567

# false = send real email (requires credentials below)
# true  = log only (local UI testing without SMTP)
EMAIL_DRY_RUN=false

# --- Email (Nodemailer / SMTP) from info@medgift.us ---
FROM_EMAIL=info@medgift.us
# GoDaddy: smtpout.secureserver.net | Gmail: smtp.gmail.com | M365: smtp.office365.com
EMAIL_HOST=smtpout.secureserver.net
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=info@medgift.us
EMAIL_PASS=

# IMPORTANT: If the password contains #, wrap it in double quotes:
#   EMAIL_PASS="MyP@ss#word"
# Otherwise dotenv treats # as a comment and truncates the password.

# SMS password reset has been removed — email link only.
